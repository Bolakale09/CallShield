<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <include layout="@layout/view_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        style="@style/Text.RowSub"
        android:text="@string/log_hint" />

    <LinearLayout
        android:id="@+id/logActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnExport"
            style="@style/TextLink"
            android:text="@string/export_log" />

        <TextView
            android:id="@+id/btnClear"
            style="@style/TextLink"
            android:text="@string/clear_log" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_group"
        android:gravity="center"
        android:lineSpacingExtra="3sp"
        android:padding="28dp"
        android:text="@string/log_empty"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_group"
        android:divider="@drawable/divider_inset"
        android:dividerHeight="1dp" />
</LinearLayout>
