<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/blockedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <TextView
                    android:id="@+id/spamCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/turn_on" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_detection" />

        <TextView style="@style/RuleHint" android:text="@string/detection_hint" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/detectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detOff"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/det_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detNormal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/det_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detStrict"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/det_strict" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/detectionLevelHint"
            style="@style/RuleHint"
            android:layout_marginTop="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAsk"
            style="@style/RuleSwitch"
            android:text="@string/sw_ask" />
        <TextView style="@style/RuleHint" android:text="@string/sw_ask_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_scan" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_rules" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnabled"
            style="@style/RuleSwitch"
            android:text="@string/sw_enabled" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swUnknown"
            style="@style/RuleSwitch"
            android:text="@string/sw_unknown" />
        <TextView style="@style/RuleHint" android:text="@string/sw_unknown_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swHidden"
            style="@style/RuleSwitch"
            android:text="@string/sw_hidden" />
        <TextView style="@style/RuleHint" android:text="@string/sw_hidden_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swCalledBefore"
            style="@style/RuleSwitch"
            android:text="@string/sw_called" />
        <TextView
            android:id="@+id/swCalledBeforeHint"
            style="@style/RuleHint"
            android:text="@string/sw_called_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swRepeat"
            style="@style/RuleSwitch"
            android:text="@string/sw_repeat" />
        <TextView style="@style/RuleHint" android:text="@string/sw_repeat_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swSilence"
            style="@style/RuleSwitch"
            android:text="@string/sw_silence" />
        <TextView style="@style/RuleHint" android:text="@string/sw_silence_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNotify"
            style="@style/RuleSwitch"
            android:text="@string/sw_notify" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_lists" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLog"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlock"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_block" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_samsung" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/samsung_tips"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefaultApps"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_default_apps" />
    </LinearLayout>
</ScrollView>
