    <!-- Help -->
    <string name="help_title">Setting up on Samsung</string>
    <string name="help_body">CallShield must be your caller ID &amp; spam app. If it isn’t, open Settings › Apps › Choose default apps › Caller ID &amp; spam app and pick CallShield.\n\nIt works on both SIMs and needs no battery settings: Android starts it only when a call comes in.\n\nSave numbers you can’t miss (bank, school, hospital) in Contacts or Always allow.\n\nWhatsApp calls aren’t covered. In WhatsApp, turn on Settings › Privacy › Calls › Silence unknown callers.</string>
    <string name="btn_default_apps">Open default apps</string>
    <string name="close">Close</string>
    <string name="cancel">Cancel</string>
    <string name="back">Back</string>
    <string name="manual_title">Pick CallShield in settings</string>
    <string name="manual_steps">Open Settings › Apps › Choose default apps › Caller ID &amp; spam app, then pick CallShield.</string>
    <string name="need_contacts">CallShield needs Contacts to tell your people from strangers. Without it, nothing is blocked.</string>
    <string name="need_call_log">This needs call log access.</string>

